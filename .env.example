# Discord Bot Token (required for live deploys)
DISCORD_TOKEN=your_bot_token_here

# Environment (optional)
# Labels the runtime environment. The bot connects to Discord unless
# DISABLE_DISCORD_GATEWAY is enabled for smoke-test startup.
# Use "production" for the live deploy. Local/manual testing can stay on
# "development" or any other non-production value.
# ENVIRONMENT=development

# Smoke-test mode (optional)
# Set to 1/true/yes/on to validate startup in a preview deploy without
# connecting to Discord. A real token is not required in this mode.
# DISABLE_DISCORD_GATEWAY=1

# Data directory (optional)
# Production example: /app/data (must use persistent volume)
# Local default: ./data
# DATA_DIR=./data

# Database path (optional)
# Defaults to DATA_DIR/typer.db
# Production example: /app/data/typer.db
# Local default: ./data/typer.db
# DB_PATH=/app/data/typer.db

# Backup directory (optional)
# Defaults to DATA_DIR/backups
# Production example: /app/data/backups
# Local default: ./data/backups
# BACKUP_DIR=/app/data/backups

# Logging (optional)
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Channel ID for reminders (optional)
REMINDER_CHANNEL_ID=123456789012345678

# Timezone (default: UTC)
# Deadline inputs in admin workflows are interpreted in this timezone.
# Existing stored fixtures are unaffected (offsets are embedded in stored ISO strings).
TZ=UTC
